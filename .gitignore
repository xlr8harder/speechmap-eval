# Canonical judge datasets and publication bundles stay versioned with the
# evaluation code. Older candidate generations and banked vLLM predictions are
# retained locally but are derived artifacts.
!/judge_evaluation/gold_review/*.jsonl
!/judge_evaluation/gold_v2/**/*.jsonl
!/judge_evaluation/gold_v2/**/*.json
!/judge_evaluation/publish/**/*.jsonl
!/judge_evaluation/publish/**/*.json
!/judge_evaluation/quant_accuracy_candidates_20260714.json
!/judge_evaluation/qwen36_fp8_mtp3_gpu_profiles.json
/judge_evaluation/gold_v2/candidates_v2-beta[1-4].jsonl
/judge_evaluation/gold_v2/candidates_v2-beta[1-4].summary.json
/judge_evaluation/gold_v2/*_vllm_eval.jsonl
/judge_evaluation/gold_v2/*_vllm_eval.summary.json

# Machine-local and remote-run state.
/_remote_gpu_backup_*/
/_remote_manifest_*/
/run_logs/
/unsloth_compiled_cache/
